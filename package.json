{
  "name": "varco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Varco — verifica di accessibilità e kit EAA per imprese e web agency italiane",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/overpass": "5.3.0",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "axe-core": "4.14.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
